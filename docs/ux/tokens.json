  "font": {
    "display": {
      "family": "Fredoka_600SemiBold",
      "package": "@expo-google-fonts/fredoka",
      "fallback": "sans-serif-medium"
    },
    "displayBold": {
      "family": "Fredoka_700Bold",
      "package": "@expo-google-fonts/fredoka",
      "fallback": "sans-serif-medium"
    },
    "body": {
      "family": "Nunito_400Regular",
      "package": "@expo-google-fonts/nunito",
      "fallback": "sans-serif"
    },
    "bodySemibold": {
      "family": "Nunito_600SemiBold",
      "package": "@expo-google-fonts/nunito",
      "fallback": "sans-serif"
    },
    "bodyBold": {
      "family": "Nunito_700Bold",
      "package": "@expo-google-fonts/nunito",
      "fallback": "sans-serif-medium"
    },
    "bodyExtraBold": {
      "family": "Nunito_800ExtraBold",
      "package": "@expo-google-fonts/nunito",
      "fallback": "sans-serif-medium"
    }
  },
  "fontSize": {
    "caption": 13,
    "overline": 12,
    "label": 14,
    "body": 16,
    "button": 16,
    "title3": 18,
    "title2": 22,
    "title1": 28,
    "display": 34,
    "countdown": 40,
    "code": 28
  },
  "lineHeight": {
    "caption": 18,
    "overline": 16,
    "label": 20,
    "body": 24,
    "button": 20,
    "title3": 24,
    "title2": 28,
    "title1": 34,
    "display": 40,
    "countdown": 44,
    "code": 34
  },
  "typography": {
    "display": {
      "font": "display",
      "size": "display",
      "lineHeight": "display",
      "maxFontSizeMultiplier": 1.5
    },
    "title1": {
      "font": "display",
      "size": "title1",
      "lineHeight": "title1",
      "maxFontSizeMultiplier": 1.6
    },
    "title2": {
      "font": "display",
      "size": "title2",
      "lineHeight": "title2",
      "maxFontSizeMultiplier": 1.8
    },
    "title3": {
      "font": "bodyBold",
      "size": "title3",
      "lineHeight": "title3",
      "maxFontSizeMultiplier": 2
    },
    "body": {
      "font": "body",
      "size": "body",
      "lineHeight": "body",
      "maxFontSizeMultiplier": 2
    },
    "bodyStrong": {
      "font": "bodyBold",
      "size": "body",
      "lineHeight": "body",
      "maxFontSizeMultiplier": 2
    },
    "label": {
      "font": "bodyBold",
      "size": "label",
      "lineHeight": "label",
      "maxFontSizeMultiplier": 2
    },
    "button": {
      "font": "bodyExtraBold",
      "size": "button",
      "lineHeight": "button",
      "maxFontSizeMultiplier": 1.8
    },
    "caption": {
      "font": "bodySemibold",
      "size": "caption",
      "lineHeight": "caption",
      "maxFontSizeMultiplier": 2
    },
    "overline": {
      "font": "bodyExtraBold",
      "size": "overline",
      "lineHeight": "overline",
      "letterSpacing": 0.8,
      "textTransform": "uppercase",
      "maxFontSizeMultiplier": 1.8
    },
    "countdown": {
      "font": "display",
      "size": "countdown",
      "lineHeight": "countdown",
      "fontVariant": ["tabular-nums"],
      "maxFontSizeMultiplier": 1.4
    },
    "code": {
      "font": "bodyExtraBold",
      "size": "code",
      "lineHeight": "code",
      "letterSpacing": 4,
      "maxFontSizeMultiplier": 1.5
    }
  },
  "space": {
    "none": 0,
    "xxs": 2,
    "xs": 4,
    "sm": 8,
    "md": 12,
    "lg": 16,
    "xl": 20,
    "xxl": 24,
    "xxxl": 32,
    "huge": 48,
    "giant": 64,
    "gutter": 20
  },
  "radius": {
    "xs": 6,
    "sm": 10,
    "md": 14,
    "lg": 20,
    "xl": 28,
    "full": 9999
  },
  "size": {
    "minTouchTarget": 48,
    "buttonHeight": 52,
    "buttonHeightSmall": 40,
    "inputHeight": 56,
    "iconSm": 20,
    "iconMd": 24,
    "iconLg": 32,
    "avatarSm": 32,
    "avatarMd": 40,
    "avatarLg": 56,
    "avatarXl": 96,
    "chipHeight": 36,
    "focusRingWidth": 2,
    "focusRingOffset": 2,
    "borderWidth": 1,
    "borderWidthStrong": 1.5,
    "bottomSheetHandle": {
      "width": 36,
      "height": 4
    },
    "maxContentWidth": 560
  },
  "shadow": {
    "none": {
      "elevation": 0,
      "shadowColor": "#000000",
      "shadowOpacity": 0,
      "shadowRadius": 0,
      "shadowOffset": {
        "width": 0,
        "height": 0
      }
    },
    "sm": {
      "elevation": 1,
      "shadowColor": "#2B1E1A",
      "shadowOpacity": 0.06,
      "shadowRadius": 3,
      "shadowOffset": {
        "width": 0,
        "height": 1
      }
    },
    "md": {
      "elevation": 3,
      "shadowColor": "#2B1E1A",
      "shadowOpacity": 0.1,
      "shadowRadius": 8,
      "shadowOffset": {
        "width": 0,
        "height": 3
      }
    },
    "lg": {
      "elevation": 8,
      "shadowColor": "#2B1E1A",
      "shadowOpacity": 0.16,
      "shadowRadius": 20,
      "shadowOffset": {
        "width": 0,
        "height": 8
      }
    }
  },
  "opacity": {
    "disabled": 0.5,
    "pressedOverlay": 0.12,
    "scrim": 0.55
  },
  "duration": {
    "instant": 100,
    "fast": 150,
    "normal": 250,
    "slow": 400,
    "skeletonPulse": 1200,
    "toast": 4000,
    "toastWithAction": 6000,
    "drawMin": 1800,
    "drawLoop": 900,
    "revealHold": 1200,
    "revealFlip": 600,
    "confetti": 1800,
    "countUp": 500
  },
  "easing": {
    "standard": [0.2, 0, 0, 1],
    "decelerate": [0, 0, 0, 1],
    "accelerate": [0.3, 0, 1, 1],
    "linear": [0, 0, 1, 1]
  },
  "spring": {
    "gentle": {
      "damping": 18,
      "stiffness": 180,
      "mass": 1
    },
    "bouncy": {
      "damping": 12,
      "stiffness": 200,
      "mass": 1
    },
    "snappy": {
      "damping": 22,
      "stiffness": 320,
      "mass": 1
    }
  },
  "haptics": {
    "selection": "Haptics.selectionAsync()",
    "tapLight": "Haptics.impactAsync(Haptics.ImpactFeedbackStyle.Light)",
    "tapMedium": "Haptics.impactAsync(Haptics.ImpactFeedbackStyle.Medium)",
    "reveal": "Haptics.impactAsync(Haptics.ImpactFeedbackStyle.Heavy)",
    "success": "Haptics.notificationAsync(Haptics.NotificationFeedbackType.Success)",
    "warning": "Haptics.notificationAsync(Haptics.NotificationFeedbackType.Warning)",
    "error": "Haptics.notificationAsync(Haptics.NotificationFeedbackType.Error)"
  },
  "zIndex": {
    "base": 0,
    "sticky": 10,
    "sheet": 20,
    "toast": 30,
    "modal": 40
  }
}
