# Copia a apps/mobile/.env para desarrollo local. Nunca subas valores reales.
# Todo lo que empieza por EXPO_PUBLIC_ queda dentro del APK: NO pongas secretos aquí.
# En EAS, las mismas variables se definen por entorno (development, preview, production).

# development | staging | production
EXPO_PUBLIC_APP_ENV=development
# URL de la API (sin / al final). También define el host de los App Links /i/<CODIGO>.
EXPO_PUBLIC_API_URL=https://entre-nos-api-staging.<cuenta>.workers.dev
# Client ID web de Google OAuth (serverClientId del SDK de Android)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# Política de privacidad, términos y ayuda
EXPO_PUBLIC_PRIVACY_URL=
EXPO_PUBLIC_TERMS_URL=
EXPO_PUBLIC_HELP_URL=
# Solo staging/e2e: muestra "Entrar de prueba" (POST /v1/auth/dev). Nunca en producción.
EXPO_PUBLIC_DEV_LOGIN=0
EXPO_PUBLIC_DEV_LOGIN_KEY=
# Build (no EXPO_PUBLIC): id del proyecto EAS para los tokens de push y versionCode
EAS_PROJECT_ID=
ANDROID_VERSION_CODE=1
# Solo iOS (aún sin publicar)
GOOGLE_IOS_URL_SCHEME=
