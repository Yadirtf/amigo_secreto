# Copia a apps/api/.dev.vars para desarrollo local con `wrangler dev`.
# Nunca subas valores reales al repositorio.

# Cadena de conexión de MongoDB Atlas (usuario de mínimo privilegio, TLS)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.example.mongodb.net/entrenos_staging?retryWrites=true&w=majority
# Llave para firmar los access tokens (32+ bytes aleatorios en base64)
JWT_SECRET=
# Client IDs de Google OAuth aceptados (separados por coma: web, android)
GOOGLE_CLIENT_IDS=
# Token de acceso de Expo para enviar push (opcional, mejora límites)
EXPO_ACCESS_TOKEN=
# Optional: public contact shown at /privacidad (privacy policy).
CONTACT_EMAIL=
